{
    "dataRoles": [
        {
            "displayName": "Valor",
            "name": "measure",
            "kind": "Measure",
            "description": "El valor a mostrar en el indicador del medidor"
        },
        {
            "displayName": "Valor Mínimo",
            "name": "min",
            "kind": "Measure",
            "description": "El valor mínimo de la escala del medidor"
        },
        {
            "displayName": "Valor Máximo",
            "name": "max",
            "kind": "Measure",
            "description": "El valor máximo de la escala del medidor"
        },
        {
            "displayName": "Valor Objetivo",
            "name": "target",
            "kind": "Measure",
            "description": "El valor objetivo para mostrar en el medidor"
        },
        {
            "displayName": "Meta con margen",
            "name": "targetWithMargin",
            "kind": "Measure",
            "description": "Marcador discontinuo de la meta con margen"
        },
        {
            "displayName": "Programado",
            "name": "programmed",
            "kind": "Measure",
            "description": "Marcador triangular del valor programado"
        },
        {
            "displayName": "Real mes anterior",
            "name": "previousMonth",
            "kind": "Measure",
            "description": "Marcador circular del real del mes anterior"
        },
        {
            "displayName": "Periodo (mes)",
            "name": "period",
            "kind": "Grouping",
            "description": "Opcional. Etiqueta del periodo (p. ej. POA_Mes[Abrev]) para la sparkline Real / Programado. Debe tener «Ordenar por columna» (POA_Mes[Abrev] → POA_Mes[Mes]) o usar «Orden del periodo»; el visual no deduce el orden de los nombres de mes. Un solo año y un solo indicador en contexto."
        },
        {
            "displayName": "Orden del periodo",
            "name": "periodOrder",
            "kind": "Grouping",
            "description": "Opcional. Clave numérica o de fecha que fija el orden cronológico de la serie (p. ej. POA_Mes[Mes]). Si falta, se usa el orden del host por «Periodo (mes)»."
        },
        {
            "displayName": "Periodo actual",
            "name": "currentPeriod",
            "kind": "Measure",
            "description": "Opcional. Periodo que muestran el medidor y el pie (p. ej. POA Mes sel); se compara con «Orden del periodo» o, sin él, con la etiqueta. Si falta, el último periodo con Real."
        },
        {
            "displayName": "Umbral Bajo",
            "name": "lowThreshold",
            "kind": "Measure"
        },
        {
            "displayName": "Umbral Medio",
            "name": "midThreshold",
            "kind": "Measure"
        },
        {
            "displayName": "Semáforo (color de la fuente)",
            "name": "semaphore",
            "kind": "Measure",
            "description": "Texto del semáforo de la fuente (Verde/Amarillo/Rojo, Sin semaforizar, clase text-* o color #hex). Si está presente sustituye al color calculado por umbrales."
        },
        {
            "displayName": "Semáforo por periodo",
            "name": "trendSemaphore",
            "kind": "Measure",
            "description": "Opcional. Semáforo de cada periodo para los puntos de la sparkline (p. ej. POA Semáforo mes color). Si está vacío en un periodo, se usa «Semáforo» evaluado en ese periodo y luego los umbrales de ese periodo."
        },
        {
            "displayName": "Información sobre herramientas",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Campos adicionales que se muestran en el tooltip"
        }
    ],
    "objects": {
        "gauge": {
            "displayName": "Configuración del Medidor",
            "properties": {
                "min": {
                    "displayName": "Valor Mínimo",
                    "description": "El valor mínimo permitido para el medidor",
                    "type": {
                        "numeric": true
                    }
                },
                "max": {
                    "displayName": "Valor Máximo",
                    "description": "El valor máximo permitido para el medidor",
                    "type": {
                        "numeric": true
                    }
                },
                "target": {
                    "displayName": "Valor Objetivo",
                    "type": {
                        "numeric": true
                    }
                },
                "startAngle": {
                    "displayName": "Ángulo Inicial (grados)",
                    "type": {
                        "numeric": true
                    }
                },
                "endAngle": {
                    "displayName": "Ángulo Final (grados)",
                    "type": {
                        "numeric": true
                    }
                },
                "thickness": {
                    "displayName": "Grosor del Medidor",
                    "type": {
                        "numeric": true
                    }
                },
                "topMargin": {
                    "displayName": "Margen Superior",
                    "description": "Aire reservado arriba del vértice del arco, bajo la banda de título",
                    "type": {
                        "numeric": true
                    }
                },
                "arcScale": {
                    "displayName": "Escala del Arco (%)",
                    "type": {
                        "numeric": true
                    }
                },
                "offsetY": {
                    "displayName": "Desplazamiento Vertical (px)",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "ranges": {
            "displayName": "Rangos de Color",
            "properties": {
                "showRanges": {
                    "displayName": "Mostrar Rangos",
                    "type": {
                        "bool": true
                    }
                },
                "lowerIsBetter": {
                    "displayName": "Menor es mejor",
                    "description": "Indicadores descendentes: valores bajos son favorables (invierte colores de rangos y desempeño)",
                    "type": {
                        "bool": true
                    }
                },
                "lowColor": {
                    "displayName": "Color Bajo",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "mediumColor": {
                    "displayName": "Color Medio",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "highColor": {
                    "displayName": "Color Alto",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "valueLabel": {
            "displayName": "Etiqueta",
            "properties": {
                "show": {
                    "displayName": "Mostrar Valor",
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "displayName": "Color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fontSize": {
                    "displayName": "Tamaño de Fuente",
                    "type": {
                        "numeric": true
                    }
                },
                "fontFamily": {
                    "displayName": "Familia de Fuente",
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                }
            }
        },
        "valueMarker": {
            "displayName": "Marcador",
            "properties": {
                "show": {
                    "displayName": "Mostrar Marcador",
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "displayName": "Color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "size": {
                    "displayName": "Tamaño",
                    "type": {
                        "numeric": true
                    }
                },
                "style": {
                    "displayName": "Estilo",
                    "type": {
                        "enumeration": [
                            {
                                "value": "circle",
                                "displayName": "Círculo"
                            },
                            {
                                "value": "line",
                                "displayName": "Línea"
                            },
                            {
                                "value": "triangle",
                                "displayName": "Triángulo"
                            },
                            {
                                "value": "diamond",
                                "displayName": "Diamante"
                            }
                        ]
                    }
                }
            }
        },
        "markers": {
            "displayName": "Marcadores adicionales",
            "properties": {
                "targetMarginColor": {
                    "displayName": "Color Meta con margen",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "programmedColor": {
                    "displayName": "Color Programado",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "previousMonthColor": {
                    "displayName": "Color Real mes anterior",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "trend": {
            "displayName": "Gráfico de tendencia",
            "properties": {
                "chartType": {
                    "displayName": "Tipo de gráfico",
                    "type": {
                        "enumeration": [
                            { "value": "lineDots", "displayName": "Línea con puntos" },
                            { "value": "line", "displayName": "Sólo línea" },
                            { "value": "bars", "displayName": "Barras" },
                            { "value": "area", "displayName": "Área" }
                        ]
                    }
                },
                "posXPct": {
                    "displayName": "Posición X (%)",
                    "description": "0-100% del ancho del viewport desde el borde izquierdo; ubica el pivote inferior-izquierdo de la caja (el punto fijo al rotar/escalar). Sin valor, se usa el % calculado automáticamente.",
                    "type": {
                        "numeric": true
                    }
                },
                "posYPct": {
                    "displayName": "Posición Y (%)",
                    "description": "0-100% del alto del viewport desde el borde superior; ubica el pivote inferior-izquierdo de la caja (el punto fijo al rotar/escalar). Sin valor, se usa el % calculado automáticamente.",
                    "type": {
                        "numeric": true
                    }
                },
                "widthPct": {
                    "displayName": "Ancho (%)",
                    "description": "0-100% del ancho del viewport. Sin valor, se usa el % calculado automáticamente.",
                    "type": {
                        "numeric": true
                    }
                },
                "heightPct": {
                    "displayName": "Alto (%)",
                    "description": "0-100% del alto del viewport. Sin valor, se usa el % calculado automáticamente.",
                    "type": {
                        "numeric": true
                    }
                },
                "angle": {
                    "displayName": "Ángulo (grados)",
                    "type": {
                        "numeric": true
                    }
                },
                "yScaleMode": {
                    "displayName": "Escala Y",
                    "type": {
                        "enumeration": [
                            { "value": "auto", "displayName": "Automática al rango" },
                            { "value": "zero", "displayName": "Desde cero" },
                            { "value": "manual", "displayName": "Mín-máx manual" }
                        ]
                    }
                },
                "yMin": {
                    "displayName": "Y Mínimo",
                    "description": "Sólo con Escala Y = Mín-máx manual. Sin valor, se muestra el mínimo del dominio automático Real/Programado ± 10%.",
                    "type": {
                        "numeric": true
                    }
                },
                "yMax": {
                    "displayName": "Y Máximo",
                    "description": "Sólo con Escala Y = Mín-máx manual. Sin valor, se muestra el máximo del dominio automático Real/Programado ± 10%.",
                    "type": {
                        "numeric": true
                    }
                },
                "showProgrammed": {
                    "displayName": "Mostrar Programado",
                    "type": {
                        "bool": true
                    }
                },
                "useSemaphoreColors": {
                    "displayName": "Colores por semáforo",
                    "description": "Activado: cada punto/segmento/barra usa el color de su semáforo. Desactivado: usa el color fijo",
                    "type": {
                        "bool": true
                    }
                },
                "fixedColor": {
                    "displayName": "Color fijo",
                    "description": "Sólo con Colores por semáforo desactivado",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "lineWidth": {
                    "displayName": "Grosor de línea",
                    "type": {
                        "numeric": true
                    }
                },
                "pointSize": {
                    "displayName": "Tamaño de punto",
                    "description": "Sin valor, es proporcional al grosor de línea (×1.67, igual que el default 0.3.5.0: 1.5 → 2.5).",
                    "type": {
                        "numeric": true
                    }
                },
                "posX": {
                    "displayName": "Posición X (px, heredado — no se usa desde 0.4.1.0)",
                    "description": "OBSOLETO. Hasta 0.4.0.0 este valor eran píxeles relativos al centro del medidor; el panel de formato ya NO lo muestra ni lo lee (usar «Posición X (%)», posXPct). Se mantiene declarado únicamente para que Power BI conserve, sin reinterpretar ni borrar, el valor de reportes guardados con 0.4.0.0 (inventario/migración manual).",
                    "type": {
                        "numeric": true
                    }
                },
                "posY": {
                    "displayName": "Posición Y (px, heredado — no se usa desde 0.4.1.0)",
                    "description": "OBSOLETO. Hasta 0.4.0.0 este valor eran píxeles relativos al centro del medidor; el panel de formato ya NO lo muestra ni lo lee (usar «Posición Y (%)», posYPct). Se mantiene declarado únicamente para que Power BI conserve, sin reinterpretar ni borrar, el valor de reportes guardados con 0.4.0.0 (inventario/migración manual).",
                    "type": {
                        "numeric": true
                    }
                },
                "width": {
                    "displayName": "Ancho (px, heredado — no se usa desde 0.4.1.0)",
                    "description": "OBSOLETO. Hasta 0.4.0.0 este valor eran píxeles relativos al centro del medidor; el panel de formato ya NO lo muestra ni lo lee (usar «Ancho (%)», widthPct). Se mantiene declarado únicamente para que Power BI conserve, sin reinterpretar ni borrar, el valor de reportes guardados con 0.4.0.0 (inventario/migración manual).",
                    "type": {
                        "numeric": true
                    }
                },
                "height": {
                    "displayName": "Alto (px, heredado — no se usa desde 0.4.1.0)",
                    "description": "OBSOLETO. Hasta 0.4.0.0 este valor eran píxeles relativos al centro del medidor; el panel de formato ya NO lo muestra ni lo lee (usar «Alto (%)», heightPct). Se mantiene declarado únicamente para que Power BI conserve, sin reinterpretar ni borrar, el valor de reportes guardados con 0.4.0.0 (inventario/migración manual).",
                    "type": {
                        "numeric": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "measure": {
                        "max": 1
                    },
                    "min": {
                        "max": 1
                    },
                    "max": {
                        "max": 1
                    },
                    "target": {
                        "max": 1
                    },
                    "lowThreshold": {
                        "max": 1
                    },
                    "midThreshold": {
                        "max": 1
                    },
                    "semaphore": {
                        "max": 1
                    },
                    "targetWithMargin": {
                        "max": 1
                    },
                    "programmed": {
                        "max": 1
                    },
                    "previousMonth": {
                        "max": 1
                    },
                    "period": {
                        "max": 1
                    },
                    "periodOrder": {
                        "max": 1
                    },
                    "currentPeriod": {
                        "max": 1
                    },
                    "trendSemaphore": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "period"
                            }
                        },
                        {
                            "bind": {
                                "to": "periodOrder"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 60
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "measure"
                            }
                        },
                        {
                            "bind": {
                                "to": "min"
                            }
                        },
                        {
                            "bind": {
                                "to": "max"
                            }
                        },
                        {
                            "bind": {
                                "to": "target"
                            }
                        },
                        {
                            "bind": {
                                "to": "lowThreshold"
                            }
                        },
                        {
                            "bind": {
                                "to": "midThreshold"
                            }
                        },
                        {
                            "bind": {
                                "to": "semaphore"
                            }
                        },
                        {
                            "bind": {
                                "to": "targetWithMargin"
                            }
                        },
                        {
                            "bind": {
                                "to": "programmed"
                            }
                        },
                        {
                            "bind": {
                                "to": "previousMonth"
                            }
                        },
                        {
                            "bind": {
                                "to": "tooltips"
                            }
                        },
                        {
                            "bind": {
                                "to": "currentPeriod"
                            }
                        },
                        {
                            "bind": {
                                "to": "trendSemaphore"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "sorting": {
        "implicit": {
            "clauses": [
                {
                    "role": "period",
                    "direction": 1
                }
            ]
        }
    },
    "privileges": [],
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltips"
        ]
    },
    "supportsKeyboardFocus": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true
}
