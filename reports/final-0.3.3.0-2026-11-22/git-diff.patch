diff --git a/src/components/scales.ts b/src/components/scales.ts
index 331d30c..1dd9831 100644
--- a/src/components/scales.ts
+++ b/src/components/scales.ts
@@ -85,6 +85,41 @@ export interface Thresholds {
     midThreshold: number;
 }
 
+/** 0.3.3.0: tramo [from, to] del rango que el arco pinta con `color`. */
+export interface RangeBand {
+    from: number;
+    to: number;
+    color: string;
+}
+
+/**
+ * 0.3.3.0: bandas del arco en orden min → max (min..low, low..mid, mid..max) con sus colores.
+ * Fuente única: Gauge las usa para pintar GaugeRanges y para colorear el número central.
+ */
+export function buildRangeBands(
+    range: GaugeRange,
+    thresholds: Thresholds,
+    colors: PerformanceColors,
+    lowerIsBetter: boolean
+): [RangeBand, RangeBand, RangeBand] {
+    const [first, second, third] = rangeBandColors(colors, lowerIsBetter);
+    return [
+        { from: range.min, to: thresholds.lowThreshold, color: first },
+        { from: thresholds.lowThreshold, to: thresholds.midThreshold, color: second },
+        { from: thresholds.midThreshold, to: range.max, color: third },
+    ];
+}
+
+/**
+ * 0.3.3.0: color de la banda que el arco pinta en `value`. Límites inclusivos por arriba («<=», igual que
+ * createPerformanceColorScale); las bandas de ancho cero no se pintan, así que se omiten; fuera de rango
+ * gana la banda del extremo (la escala de ángulo recorta igual). Requiere min < max (resolveRange).
+ */
+export function rangeBandColorAt(bands: RangeBand[], value: number): string {
+    const visible = bands.filter((band) => band.to > band.from);
+    return (visible.find((band) => value <= band.to) ?? visible[visible.length - 1]).color;
+}
+
 export function isFiniteNumber(value: number | null | undefined): value is number {
     return typeof value === "number" && Number.isFinite(value);
 }
